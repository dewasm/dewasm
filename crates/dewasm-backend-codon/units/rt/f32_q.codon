# requires: rt/f32_bits, rt/f32_from_bits
# Force a NaN result quiet.
# LLVM folds x * 1.0, x / 1.0 and x + -0.0 to x, which skips the signaling-NaN quieting wasm requires of every arithmetic result; generated code wraps a float operation with a constant operand in this instead.
@staticmethod
def f32_q(x: float32) -> float32:
    if x != x:
        return Rt.f32_from_bits(Rt.f32_bits(x) | UInt[32](0x400000))
    return x
