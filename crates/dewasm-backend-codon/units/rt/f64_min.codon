# requires: rt/f64_from_bits, rt/f64_bits
@staticmethod
def f64_min(a: float, b: float) -> float:
    if a != a or b != b:
        return Rt.f64_from_bits(UInt[64](0x7FF8000000000000))
    if a < b:
        return a
    if b < a:
        return b
    if a == 0.0:
        if Rt.f64_bits(a) >> UInt[64](63) != UInt[64](0) or Rt.f64_bits(b) >> UInt[64](63) != UInt[64](0):
            return Rt.f64_from_bits(UInt[64](0x8000000000000000))
        return 0.0
    return a
