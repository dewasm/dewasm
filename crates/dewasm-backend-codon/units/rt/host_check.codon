# requires: rt/trap
# The libc struct layouts decoded by stat_read and readdir_entries are verified on darwin arm64 and linux x86_64, the two CI host shapes.
# On darwin x86_64 the un-suffixed stat/readdir symbols are the legacy 32-bit-inode variants with different layouts, so an Intel Mac must refuse loudly instead of decoding garbage.
@staticmethod
def host_check() -> None:
    if __apple__:
        from C import uname(Ptr[byte]) -> int
        from C import strlen(cobj) -> int
        # Darwin struct utsname: five 256-byte fields; machine is the fifth.
        buf = Ptr[byte](1280)
        if uname(buf) == 0:
            mp = buf + 1024
            machine = str(mp, strlen(mp))
            if machine != "arm64":
                Rt.trap("unsupported host for the bundled WASI filesystem: darwin " + machine + " (verified hosts: darwin arm64, linux x86_64)")
