# requires: rt/trap
@staticmethod
def i64_div_s(a: UInt[64], b: UInt[64]) -> UInt[64]:
    if b == UInt[64](0):
        Rt.trap("integer divide by zero")
    if a == UInt[64](0x8000000000000000) and b == UInt[64](0xFFFFFFFFFFFFFFFF):
        Rt.trap("integer overflow")
    sa = Int[64](a)
    sb = Int[64](b)
    q = sa // sb
    if q < Int[64](0) and q * sb != sa:
        q = q + Int[64](1)
    return UInt[64](q)
