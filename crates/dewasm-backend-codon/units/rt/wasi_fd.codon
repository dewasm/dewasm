# One fd-table entry: a host file descriptor (kind 1), or a sandboxed directory (kind 2).
# Kind 3 is a stdio stream: no close, and SPIPE on seek-family calls.
# It carries the wasmtime-modelled per-fd capability fields (rights base/inheriting, fdflags).
# It also carries the memoized filetype, -1 until first queried.
# So the dynamic backends' parallel fd_meta is folded into the entry itself.
# `entries` is the fd_readdir listing cache of (name bytes, filetype, inode) triples.
# It is valid only while `entries_valid`.
class WasiFd:
    kind: int
    host_fd: int
    host_path: str
    preopen_name: bytes
    has_preopen_name: bool
    entries: List[Tuple[bytes, int, int]]
    entries_valid: bool
    base: int
    inheriting: int
    fdflags: int
    filetype: int
    def __init__(self, kind: int, host_fd: int, host_path: str, base: int, inheriting: int):
        self.kind = kind
        self.host_fd = host_fd
        self.host_path = host_path
        self.preopen_name = bytes(Ptr[UInt[8]](1), 0)
        self.has_preopen_name = False
        self.entries = List[Tuple[bytes, int, int]]()
        self.entries_valid = False
        self.base = base
        self.inheriting = inheriting
        self.fdflags = 0
        self.filetype = -1
