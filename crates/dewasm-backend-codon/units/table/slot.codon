# requires: rt/trap, rt/boxed
# Resolve a call_indirect slot to its funcref: bounds, null, then the structural type key.
def slot(self, i: UInt[32], ty: str) -> Rt.Funcref:
    idx = int(i)
    if idx >= len(self.slots):
        Rt.trap("undefined element")
    fr = self.slots[idx]
    if fr is None:
        Rt.trap("uninitialized element")
    frv: Rt.Funcref = fr
    if frv.ty != ty:
        Rt.trap("indirect call type mismatch")
    return frv
