# requires: memory/read_path, wasi/resolve_path, wasi/fst_times, wasi/set_host_times, wasi/fs_errno, rt/path_stat
def wasi_path_filestat_set_times(self, dirfd: UInt[32], flags: UInt[32], path_ptr: UInt[32], path_len: UInt[32], atim: UInt[64], mtim: UInt[64], fst_flags: UInt[32]) -> UInt[32]:
    rel = self.memory.read_path(int(path_ptr), int(path_len))
    follow = int(flags) & 0x1 != 0  # lookupflags::SYMLINK_FOLLOW
    host, err = self.resolve_path(int(dirfd), rel, follow)
    if err != 0:
        return UInt[32](err)
    st = Rt.path_stat(host, follow)
    if st is None:
        return self.fs_errno()
    a, m, terr = self.fst_times(st, atim, mtim, fst_flags)
    if terr != 0:
        return UInt[32](terr)
    if not self.set_host_times(host, -1, a, m, follow):
        return self.fs_errno()
    return UInt[32](self.ERRNO_SUCCESS)
