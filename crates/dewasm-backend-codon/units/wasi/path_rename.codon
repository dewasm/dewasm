# requires: memory/read_path, wasi/resolve_path, wasi/fs_errno, rt/lexists
def wasi_path_rename(self, old_dirfd: UInt[32], old_path_ptr: UInt[32], old_path_len: UInt[32], new_dirfd: UInt[32], new_path_ptr: UInt[32], new_path_len: UInt[32]) -> UInt[32]:
    from C import rename(cobj, cobj) -> int
    old_rel = self.memory.read_path(int(old_path_ptr), int(old_path_len))
    # rename(2) never follows trailing symlinks: it moves the link itself and replaces the destination link.
    old_host, err = self.resolve_path(int(old_dirfd), old_rel, False)
    if err != 0:
        return UInt[32](err)
    new_rel = self.memory.read_path(int(new_path_ptr), int(new_path_len))
    new_host, err2 = self.resolve_path(int(new_dirfd), new_rel, False)
    if err2 != 0:
        return UInt[32](err2)
    # The preserved slash lets the host rename(2) enforce the existing and missing shapes; a *nonexistent* slash-suffixed destination is stripped so the rename proceeds, as wasmtime does.
    if new_host.endswith("/") and not Rt.lexists(new_host[:len(new_host) - 1]):
        new_host = new_host[:len(new_host) - 1]
    if rename(old_host.c_str(), new_host.c_str()) != 0:
        return self.fs_errno()
    return UInt[32](self.ERRNO_SUCCESS)
