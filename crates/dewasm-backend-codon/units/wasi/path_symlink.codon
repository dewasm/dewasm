# requires: memory/read_path, wasi/resolve_path, wasi/fs_errno, rt/lexists, rt/isdir
def wasi_path_symlink(self, old_path_ptr: UInt[32], old_path_len: UInt[32], fd: UInt[32], new_path_ptr: UInt[32], new_path_len: UInt[32]) -> UInt[32]:
    from C import symlink(cobj, cobj) -> int
    target = self.memory.read_path(int(old_path_ptr), int(old_path_len))
    # The symlink target is stored verbatim (never pre-resolved); containment is enforced when the link is later followed.
    # An absolute target can never be confined to the preopen, so it is rejected up front.
    if target.startswith("/"):
        return UInt[32](self.ERRNO_NOTCAPABLE)
    new_rel = self.memory.read_path(int(new_path_ptr), int(new_path_len))
    link_host, err = self.resolve_path(int(fd), new_rel, False)
    if err != 0:
        return UInt[32](err)
    # Slash-suffixed link name, per wasmtime: EEXIST on a directory, ENOTDIR on a non-directory, ENOENT when missing.
    if link_host.endswith("/"):
        bare = link_host[:len(link_host) - 1]
        if Rt.lexists(bare):
            return UInt[32](self.ERRNO_EXIST if Rt.isdir(bare) else self.ERRNO_NOTDIR)
        return UInt[32](self.ERRNO_NOENT)
    if symlink(target.c_str(), link_host.c_str()) != 0:
        return self.fs_errno()
    return UInt[32](self.ERRNO_SUCCESS)
