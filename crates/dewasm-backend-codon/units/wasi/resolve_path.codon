# requires: wasi/fd_entry, rt/realpath_ns, rt/lexists
def within(self, base: str, path: str) -> bool:
    prefix = base if base.endswith("/") else base + "/"
    return path == base or path.startswith(prefix)

# Resolves a guest-relative path against a directory fd to an absolute host path, confined to that directory fd's own (already-realpath'd) root; returns (host_path, errno) with errno 0 on success.
# Every call re-validates against its own dirfd's root, so nested path_opens can't be used to launder an escape one level cheaper.
#
# A non-directory base fd is NOTDIR (a file used as a dirfd); an absent one is BADF.
# A leading "/" is NOTCAPABLE before any join (an absolute guest path escapes the preopen).
# A trailing slash is preserved on the returned host path so the underlying host call enforces the POSIX "must be a directory" rule.
#
# `follow_last=False` resolves the parent but leaves the final component untouched (the AT_SYMLINK_NOFOLLOW shape), for syscalls that operate on a symlink itself.
# A trailing "." or ".." is never a symlink, so those fall back to full resolution.
#
# Known limitation (shared with the dynamic backends): this is a check-then-open, not an atomic openat(2)-beneath resolution; accepted for a single-process research/demo runtime, not a multi-tenant sandbox host.
def resolve_path(self, dirfd: int, rel: str, follow_last: bool) -> Tuple[str, int]:
    f = self.fd_entry(dirfd)
    if f is None:
        return ("", self.ERRNO_BADF)
    if f.kind != 2:
        return ("", self.ERRNO_NOTDIR)
    if "\x00" in rel:
        return ("", self.ERRNO_INVAL)
    if rel.startswith("/"):
        return ("", self.ERRNO_NOTCAPABLE)
    base = f.host_path
    trailing = len(rel) > 1 and rel.endswith("/")
    core = rel
    while core.endswith("/"):
        core = core[:len(core) - 1]
    joined = (base + "/" + core) if len(core) > 0 else base
    sl = joined.rfind("/")
    last = joined[sl + 1:]
    parent = joined[:sl] if sl > 0 else "/"
    if not follow_last and last != "." and last != "..":
        # Containment is checked before existence: a path whose "..s" escape the sandbox is NOTCAPABLE even when the escaped-to parent does not exist.
        real_parent = Rt.realpath_ns(parent)
        if not self.within(base, real_parent):
            return ("", self.ERRNO_NOTCAPABLE)
        if not Rt.lexists(real_parent):
            return ("", self.ERRNO_NOENT)
        host = real_parent + "/" + last
        return (host + "/" if trailing else host, 0)
    # A final "." resolves to its parent: wasi-libc rewrites a path that *is* a preopen to ".", and the host call would reject "<parent>/." once that parent is a non-directory preopen.
    if last == ".":
        joined = parent
    if Rt.lexists(joined):
        real = Rt.realpath_ns(joined)
        if not self.within(base, real):
            return ("", self.ERRNO_NOTCAPABLE)
        return (real + "/" if trailing else real, 0)
    # The final component is missing: resolve the parent and re-attach it, so a create (path_open O_CREAT) still gets a sandboxed target path.
    jsl = joined.rfind("/")
    jlast = joined[jsl + 1:]
    jparent = joined[:jsl] if jsl > 0 else "/"
    real_parent = Rt.realpath_ns(jparent)
    if not self.within(base, real_parent):
        return ("", self.ERRNO_NOTCAPABLE)
    if not Rt.lexists(real_parent):
        return ("", self.ERRNO_NOENT)
    host = real_parent + "/" + jlast
    return (host + "/" if trailing else host, 0)
