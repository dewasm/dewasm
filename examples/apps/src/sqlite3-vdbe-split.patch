+static SQLITE_NOINLINE int vdbeOpRewind(Vdbe *p, Op *pOp, int *pRc){
+  int rc = SQLITE_OK;
+  VdbeCursor *pC;
+  BtCursor *pCrsr;
+  int res;
+
+  assert( pOp->p1>=0 && pOp->p1<p->nCursor );
+  assert( pOp->p5==0 );
+  assert( pOp->p2>=0 && pOp->p2<p->nOp );
+
+  pC = p->apCsr[pOp->p1];
+  assert( pC!=0 );
+  assert( isSorter(pC)==(pOp->opcode==OP_SorterSort) );
+  res = 1;
+#ifdef SQLITE_DEBUG
+  pC->seekOp = OP_Rewind;
+#endif
+  if( isSorter(pC) ){
+    rc = sqlite3VdbeSorterRewind(pC, &res);
+  }else{
+    assert( pC->eCurType==CURTYPE_BTREE );
+    pCrsr = pC->uc.pCursor;
+    assert( pCrsr );
+    rc = sqlite3BtreeFirst(pCrsr, &res);
+    pC->deferredMoveto = 0;
+    pC->cacheStatus = CACHE_STALE;
+  }
+  if( rc ) { *pRc = rc; return VS_ERROR; }
+  pC->nullRow = (u8)res;
+  if( pOp->p2>0 ){
+    VdbeBranchTaken(res!=0,2);
+    if( res ) return VS_JUMP_P2;
+  }
+  return VS_NEXT;
+}
+
+static SQLITE_NOINLINE int vdbeOpNext(Vdbe *p, Op *pOp, int *pRc){
+  VdbeCursor *pC;
+  sqlite3 *db = p->db;
+  int rc;
+
+  pC = p->apCsr[pOp->p1];
+  if( pOp->opcode==OP_SorterNext ){
+    assert( isSorter(pC) );
+    rc = sqlite3VdbeSorterNext(db, pC);
+  }else if( pOp->opcode==OP_Prev ){
+    assert( pC!=0 );
+    assert( pC->deferredMoveto==0 );
+    assert( pC->eCurType==CURTYPE_BTREE );
+    rc = sqlite3BtreePrevious(pC->uc.pCursor, pOp->p3);
+  }else{
+    assert( pC!=0 );
+    assert( pC->deferredMoveto==0 );
+    assert( pC->eCurType==CURTYPE_BTREE );
+    rc = sqlite3BtreeNext(pC->uc.pCursor, pOp->p3);
+  }
+
+  pC->cacheStatus = CACHE_STALE;
+  VdbeBranchTaken(rc==SQLITE_OK,2);
+  if( rc==SQLITE_OK ){
+    pC->nullRow = 0;
+    p->aCounter[pOp->p5]++;
+#ifdef SQLITE_TEST
+    sqlite3_search_count++;
+#endif
+    return VS_JUMP_P2I;
+  }
+  if( rc!=SQLITE_DONE ){
+    *pRc = rc;
+    return VS_ERROR;
+  }
+  pC->nullRow = 1;
+  return VS_INTERRUPT;
+}
