+// Current wasi-libc takes null-terminated paths where the guest hands us (pointer, length); copy through a bounded buffer.
+static const char * m3_nt_path(char * buf, size_t cap, const char * path, __wasi_size_t len)
+{
+    if ((size_t) len >= cap) len = (__wasi_size_t) (cap - 1);
+    memcpy(buf, path, len);
+    buf[len] = 0;
+    return buf;
+}
