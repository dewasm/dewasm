<%= form_with(model: post) do |form| %>
  <% if post.errors.any? %>
    <div class="errors">
      <h2><%= pluralize(post.errors.count, "error") %> prohibited this post from being saved:</h2>
      <ul>
        <% post.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= form.label :title %>
    <%= form.text_field :title %>
  </div>

  <div class="field">
    <%= form.label :body, "Body (HTML, cleaned by sanitize when shown)" %>
    <%= form.textarea :body %>
  </div>

  <div class="actions">
    <%= form.submit %>
    <%= link_to "Cancel", post.persisted? ? post_path(post) : posts_path, class: "button" %>
  </div>
<% end %>
