<%# herb:slots server %>
<%# herb:state (code: false) %>
<% content_for :title, @post.title %>
<% content_for :head, tag.style(highlight_css.html_safe) %>

<%# `code` is a ReActionView state the browser owns; the button flips it, and the browser asks the
    server for the branches below that read it. The HTML branch runs Pygments on each request. %>
<article id="<%= dom_id @post %>" class="post">
  <h2><%= link_to @post.title, @post %></h2>
  <p class="meta"><%= @post.created_at.to_fs(:long) %> · <%= pluralize(@post.comments.size, "comment") %></p>
  <div class="body">
    <% if code %>
      <%= highlighted sanitize(@post.body), "html" %>
    <% else %>
      <%= sanitize @post.body %>
    <% end %>
  </div>
</article>

<div class="actions">
  <button type="button" class="button" data-herb-toggle="code">
    <% if code %>View rendered<% else %>View HTML<% end %>
  </button>
  <% if code %>
    <span class="meta">
      The HTML this post is served as, highlighted for this request by <%= pygments_description %>.
    </span>
  <% end %>
  <% if authenticated? %>
    <%= link_to "Edit this post", edit_post_path(@post), class: "button" %>
    <%= button_to "Destroy this post", @post, method: :delete, class: "danger",
                  form: { data: { turbo_confirm: "Destroy this post?" } } %>
  <% end %>
</div>

<section id="comments">
  <h3><%= pluralize(@comments.size, "comment") %></h3>
  <% @comments.each do |comment| %>
    <div id="<%= dom_id comment %>" class="comment">
      <strong><%= comment.author %></strong>
      <span class="meta"><%= comment.created_at.to_fs(:short) %></span>
      <div><%= sanitize comment.body, tags: %w[b i em strong code a], attributes: %w[href] %></div>
    </div>
  <% end %>

  <h3>Add a comment</h3>
  <%= form_with model: [ @post, @comment ] do |form| %>
    <div class="field">
      <%= form.label :author %>
      <%= form.text_field :author, required: true %>
    </div>
    <div class="field">
      <%= form.label :body %>
      <%= form.textarea :body, rows: 3, required: true %>
    </div>
    <div class="actions"><%= form.submit "Add comment" %></div>
  <% end %>
</section>

<p><%= link_to "← All posts", posts_path %></p>
