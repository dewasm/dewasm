<% content_for :title, @post.title %>

<%= render @post, code: @code %>

<div class="actions">
  <% if @code %>
    <%= link_to "View rendered", post_path(@post), class: "button" %>
    <span class="meta">
      The HTML this post is served as, highlighted on this page load by Pygments
      (<%= Dewasm::Pygments.version %>, converted to Ruby).
    </span>
  <% else %>
    <%= link_to "View HTML", post_path(@post, code: 1), class: "button" %>
  <% end %>
  <% if authenticated? %>
    <%= link_to "Edit this post", edit_post_path(@post), class: "button" %>
    <%= button_to "Destroy this post", @post, method: :delete, class: "danger",
                  form: { data: { turbo_confirm: "Destroy this post?" } } %>
  <% end %>
</div>

<section id="comments">
  <h3><%= pluralize(@comments.size, "comment") %></h3>
  <% @comments.each do |comment| %>
    <div id="<%= dom_id comment %>" class="comment">
      <strong><%= comment.author %></strong>
      <span class="meta"><%= comment.created_at.to_fs(:short) %></span>
      <div><%= sanitize comment.body, tags: %w[b i em strong code a], attributes: %w[href] %></div>
    </div>
  <% end %>

  <h3>Add a comment</h3>
  <%= form_with model: [ @post, @comment ] do |form| %>
    <div class="field">
      <%= form.label :author %>
      <%= form.text_field :author, required: true %>
    </div>
    <div class="field">
      <%= form.label :body %>
      <%= form.textarea :body, rows: 3, required: true %>
    </div>
    <div class="actions"><%= form.submit "Add comment" %></div>
  <% end %>
</section>

<p><%= link_to "← All posts", posts_path %></p>
