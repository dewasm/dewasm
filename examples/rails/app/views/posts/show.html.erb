<%# herb:slots server %>
<%# herb:state (code: false) %>
<% content_for :title, @post.title %>
<% content_for :head, tag.style(highlight_css.html_safe) %>

<article id="<%= dom_id @post %>" class="post">
  <h2><%= link_to @post.title, @post %></h2>
  <p class="meta"><%= @post.created_at.to_fs(:long) %></p>
  <div class="body">
    <% if code %>
      <pre class="highlight"><code><%= highlighted sanitize(@post.body), "html" %></code></pre>
    <% else %>
      <%= sanitize @post.body %>
    <% end %>
  </div>
</article>

<div class="actions">
  <label class="check"><input type="checkbox" <% if code %>checked<% end %>> View HTML</label>
  <% if authenticated? %>
    <%= link_to "Edit this post", edit_post_path(@post), class: "button" %>
    <%= button_to "Destroy this post", @post, method: :delete, class: "danger",
                  form: { data: { turbo_confirm: "Destroy this post?" } } %>
  <% end %>
</div>

<p><%= link_to "← All posts", posts_path %></p>
